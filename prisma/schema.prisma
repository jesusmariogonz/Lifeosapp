generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection — Prisma's advisory
  // lock during `migrate deploy` hangs/times out against pgbouncer/Neon's
  // pooled connection string. Falls back to DATABASE_URL locally where
  // there's no separate pooled/unpooled split.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum HabitFrequency {
  DAILY
  WEEKLY
  X_PER_WEEK
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  name          String?
  image         String?
  timezone      String   @default("UTC")
  currency      String   @default("USD")
  theme         String   @default("light")
  locale        String   @default("en")
  birthday      DateTime?
  units         String   @default("metric") // "metric" | "imperial" — display/input only; DB values always stored in canonical units (see WellnessLog)
  createdAt     DateTime @default(now())

  events         Event[]
  tasks          Task[]
  habits         Habit[]
  goals          Goal[]
  wellnessLogs   WellnessLog[]
  financeAccounts FinanceAccount[]
  transactions   Transaction[]
  budgets        Budget[]
  journalEntries JournalEntry[]
  weeklyReviews  WeeklyReview[]
  contacts       Contact[]
  weatherLocations WeatherLocation[]
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  location    String?
  createdAt   DateTime @default(now())

  @@index([userId, startsAt])
}

model Task {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  notes          String?
  dueDate        DateTime?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  completed      Boolean   @default(false)
  completedAt    DateTime?
  goalId         String?
  goal           Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  objectiveId    String?
  objective      Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  priority       Int       @default(2) // 1=high 2=med 3=low
  order          Int       @default(0) // manual drag/arrow ordering within the Tasks list (lower = earlier)
  // Recurrence: a recurring task is a *template* — creating one immediately
  // generates concrete Task rows with real dueDates for a rolling window
  // (see src/lib/recurrence.ts), all sharing recurringGroupId. There is no
  // virtual expansion — every recurring occurrence is a real row, so the
  // rest of the app (Dashboard, Calendar, Analytics) needs no special-casing.
  // recurrence: null = one-time, "DAILY" | "WEEKLY" | "WEEKDAYS" | "CUSTOM".
  recurrence       String?
  // Day-of-week numbers using JS Date's getUTCDay() convention (0=Sunday..6=Saturday).
  // Only meaningful when recurrence = "CUSTOM".
  recurrenceDays   Int[]    @default([])
  // Shared across every Task row generated from the same recurring template,
  // so a series can be identified/deleted together. Null for one-time tasks.
  recurringGroupId String?
  // V2: cross-area analytics hook
  createdAt      DateTime  @default(now())

  @@index([userId, dueDate])
  @@index([recurringGroupId])
}

model Habit {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  frequency      HabitFrequency @default(DAILY)
  targetPerWeek  Int?
  createdAt      DateTime       @default(now())
  logs           HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime
  completed Boolean  @default(true)

  @@unique([habitId, date])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  vision      String?
  createdAt   DateTime @default(now())

  objectives  Objective[]
  tasks       Task[]

  @@index([userId])
}

model Objective {
  id            String   @id @default(cuid())
  goalId        String
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  createdAt     DateTime @default(now())

  tasks         Task[]
  weeklyTargets WeeklyTarget[]

  @@index([goalId])
}

model WeeklyTarget {
  id          String    @id @default(cuid())
  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title       String
  weekStart   DateTime
  completed   Boolean   @default(false)

  @@index([objectiveId, weekStart])
}

model WellnessLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  sleepHours      Float?
  weight          Float?   // canonical unit: kilograms, regardless of the user's display "units" setting — convert at the API/UI edges
  steps           Int?
  exerciseMinutes Int?
  waterOz         Float?   // canonical unit: US fluid ounces (column name kept for compatibility) — convert to L/mL for metric display
  energy          Int?
  stress          Int?
  // V4: wearable/health integration hook
  source          String   @default("manual") // "manual" | "apple_health" | "google_fit" (future)
  createdAt       DateTime @default(now())

  @@unique([userId, date])
}

// V4: Relationships — functional now; feeds Calendar/Dashboard with upcoming important dates
model Contact {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String?
  notes        String?
  createdAt    DateTime        @default(now())

  importantDates ImportantDate[]

  @@index([userId])
}

model ImportantDate {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String // e.g. "Birthday", "Anniversary"
  date      DateTime // month/day matters most; year may be a placeholder
  recurring Boolean  @default(true)

  @@index([contactId])
}

model FinanceAccount {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  type    String
  balance Float    @default(0)

  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     FinanceAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount      Float
  category    String
  description String?
  date        DateTime
  isIncome    Boolean         @default(false)

  @@index([userId, date])
}

model Budget {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  monthlyLimit Float
  month        String // e.g. "2026-09"

  @@index([userId, month])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  mood      Int // 1-5
  energy    Int // 1-10
  stress    Int // 1-10
  text      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// V5: Dashboard weather — user-selected locations for the weather card
model WeatherLocation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  latitude  Float
  longitude Float
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model WeeklyReview {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart       DateTime
  tasksCompleted  Int      @default(0)
  habitsPercent   Float    @default(0)
  financeSummary  Json?
  wellnessSummary Json?
  goalsProgress   Json?
  wentWell        String?
  improve         String?
  nextPriority    String?
  // V3: AI planning assistant hook
  createdAt       DateTime @default(now())

  @@unique([userId, weekStart])
}
