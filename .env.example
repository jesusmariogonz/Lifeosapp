DATABASE_URL="postgresql://user:password@localhost:5432/lifeos?schema=public"
# Direct (non-pooled) connection used only for `prisma migrate deploy`.
# On Vercel + Neon, set this to the auto-generated DATABASE_URL_UNPOOLED
# variable — migrations hang/timeout against a pooled (pgbouncer) URL.
# Locally, the same value as DATABASE_URL is fine.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/lifeos?schema=public"
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Optional — AI Planning Assistant (V3). Without this set, /assistant shows a
# friendly "not configured" state instead of erroring.
ANTHROPIC_API_KEY=""
